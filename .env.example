# === GitHub Test Account ===
# Create a dedicated GitHub account for testing.
# Only needed for authenticated E2E tests (login, issues, PR flows).
GITHUB_USERNAME=your-test-account
GITHUB_PASSWORD=your-test-password
GITHUB_API_TOKEN=ghp_your_personal_access_token_here
GITHUB_TEST_REPO=your-username/playwright-test-repo

# === Gmail IMAP (device verification) ===
# Gmail address used for receiving GitHub device verification codes.
# Must have IMAP enabled and an App Password generated (not your regular password).
# See: https://support.google.com/accounts/answer/185833
GMAIL_ADDRESS=your-test-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# === General ===
BASE_URL=https://github.com
TEST_MODE=read-only
# HEADED=true  # uncomment to see the browser during test runs
